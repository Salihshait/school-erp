{
  "version": 2,
  "name": "school-erp",
  "builds": [
    {
      "src": "school-erp.client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "school-erp.client/api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/school-erp.client/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/school-erp.client/dist/index.html"
    }
  ]
}
